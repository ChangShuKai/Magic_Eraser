# Magic Eraser 環境變數設定範例
# 請將此檔案複製為 .env 並填入正確的值
# ⚠️ 永遠不要將 .env 提交到 Git！

# === Supabase 設定 (C-1 修復) ===
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# === Admin JWT 密鑰 (C-2 修復) ===
# 產生方式: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_JWT_SECRET=your-strong-random-secret-here

# === Admin 帳號 (C-3 修復) ===
# 產生 password hash: python -c "from passlib.context import CryptContext; print(CryptContext(schemes=['bcrypt']).hash('your-password'))"
ADMIN_PASSWORD_HASH=$2b$12$your-bcrypt-hash-here
# 產生 TOTP secret: python -c "import pyotp; print(pyotp.random_base32())"
ADMIN_TOTP_SECRET=your-totp-secret-here

# === CORS 設定 (M-5 修復) ===
# 多個來源用逗號分隔
CORS_ORIGINS=https://your-domain.com,https://your-app.vercel.app

# === TrustedHost 設定 (H-5 修復) ===
# 多個 host 用逗號分隔
ALLOWED_HOSTS=your-domain.com,your-app.vercel.app

# === Flask Debug 模式 (H-3 修復) ===
# 生產環境務必設為 false
FLASK_DEBUG=false
